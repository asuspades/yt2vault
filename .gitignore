# ─────────────────────────────────────────
# 🔐 Local config & secrets (NEVER commit)
# ─────────────────────────────────────────
config.local.ps1
*.local.*
.env
*.secrets.*

# ─────────────────────────────────────────
# 🗃️ Runtime cache & intermediates (safe to ignore)
# ─────────────────────────────────────────
# Whisper/audio cache
data/
audio/
whisper/

# Temporary processing files (script uses $env:TEMP, but be safe)
temp/
.tmp/
*.tmp

# Intermediate caption files (regenerable)
*.vtt

# Logs
*.log
logs/

# ─────────────────────────────────────────
# 🖥️ OS / Editor / Tooling
# ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.ps1xml
*.suo
*.user

# ─────────────────────────────────────────
# 🐍 Python helpers (if used)
# ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
venv/
.env.local

# ─────────────────────────────────────────
# 📦 Build / Distribution (if ever needed)
# ─────────────────────────────────────────
dist/
build/
*.zip
*.tar.gz
