# config.local.ps1 - Copy to config.local.ps1 and edit (gitignored)
# Used by yt2txt.ps1 and playlist2vault.ps1

$script:ConfigOverride = @{
    # yt2txt.ps1 paths
    DownloadDir    = "C:\Users\You\Videos\YouTube"
    WhisperDir     = "C:\Users\You\Documents\Whisper"
    TranscriberPath = "C:\Users\You\scripts\Transcribe-GPU.ps1"
    RumbleDir      = "C:\Users\You\Videos\Rumble"  # optional host override
    
    # Runtime config
    NodeRuntime    = "node"  # or "node:C:\Program Files\nodejs\node.exe"
    CookieBrowser  = "firefox"
}
