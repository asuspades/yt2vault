# config.local.ps1 - Copy to config.local.ps1 and edit (gitignored)
# Paths are resolved: env vars → this file → script defaults

$script:ConfigOverride = @{
    # Core output paths
    TranscriptRoot = "D:\Archives\YouTube\Transcripts"
    ObsidianRoot   = "C:\Users\You\Obsidian\Vaults\Youtube Channel Vault"
    
    # Whisper helper paths
    Yt2TxtScript   = "C:\tools\yt2txt.ps1"
    WhisperDir     = "E:\AI\Whisper"
    AudioDir       = "D:\Media\YouTube"
    
    # Runtime config
    NodeExe        = "node"  # Or full path: "node:C:\Program Files\nodejs\node.exe"
}
